{
  "name": "@sudobility/consumables_pages",
  "version": "0.0.65",
  "description": "Web UI components for consumable credits (credit store, purchase history, usage history)",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "CLAUDE.md"
  ],
  "scripts": {
    "build": "tsc && vite build",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "typecheck": "bunx tsc --noEmit",
    "lint": "bunx eslint src",
    "lint:fix": "bunx eslint src --fix",
    "format": "bunx prettier --write \"src/**/*.{ts,tsx}\"",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "verify": "bun run typecheck && bun run lint && bun run test:unit && bun run build",
    "prepublishOnly": "bun run build"
  },
  "peerDependencies": {
    "@sudobility/consumables_client": "^0.0.34",
    "@sudobility/design": "^1.1.63",
    "@sudobility/types": "^1.9.75",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@sudobility/consumables_client": "^0.0.34",
    "@sudobility/design": "^1.1.63",
    "@testing-library/jest-dom": "~6.10.0",
    "@testing-library/react": "~16.3.3",
    "@types/bun": "~1.4.4",
    "@types/node": "~25.9.9",
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0",
    "@typescript-eslint/eslint-plugin": "~8.72.0",
    "@typescript-eslint/parser": "~8.72.0",
    "@vitejs/plugin-react": "~5.2.0",
    "ajv": "~8.20.0",
    "eslint": "~9.39.5",
    "eslint-plugin-react-hooks": "~7.1.1",
    "eslint-plugin-react-refresh": "~0.5.7",
    "globals": "~17.13.0",
    "jsdom": "~28.1.0",
    "prettier": "~3.9.10",
    "react": "~19.3.1",
    "react-dom": "~19.3.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "~8.72.0",
    "vite": "~7.3.7",
    "vite-plugin-dts": "~4.5.4",
    "vitest": "~4.1.12"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "BUSL-1.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/Sudobility/consumables_pages.git"
  }
}
